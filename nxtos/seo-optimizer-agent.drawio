        <mxCell id="title" value="&lt;b&gt;&lt;font size=4&gt;SEO Optimizer NxtNodeAgent — full canvas (v6, as built 2026-07-09)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;One n8n workflow (25 nodes, two Schedule Triggers), deployed from workflow.json in the OKF bundle (nxtos agents/seo-optimizer/).&lt;br&gt;Every integration is a first-class node: CLI (SSH), NocoDB, Google Search Console, Langflow (rewrite brain), Hermes agent (executor). Langfuse watches everything." style="text;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="80" as="geometry" />
        </mxCell>

        <mxCell id="tenant" value="&lt;b&gt;Tenant Config (per property)&lt;/b&gt;&lt;br&gt;tenant.yaml: site, sitemap, NocoDB base, budgets,&lt;br&gt;adapter (repo, metadata_map, build_gate), autonomy tiers&lt;br&gt;&lt;font size=1&gt;examples/seo-optimizer/configs/&lt;tenant&gt;.yaml&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
