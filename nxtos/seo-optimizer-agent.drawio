        <!-- Onboarding note -->
        <mxCell id="onboard" value="&lt;i&gt;New property onboarding: one tenant YAML + nxtos-seo --provision + duplicate the two n8n workflows and point them at the new config. The package is the product; n8n is the door.&lt;/i&gt;" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1">
