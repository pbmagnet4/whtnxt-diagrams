        <!-- Load-bearing assets callout -->
        <mxCell id="load-bearing" value="&lt;b&gt;Load-bearing assets&lt;/b&gt; (if these break, the system breaks)&lt;br&gt;1. Admin dashboard &quot;needs attention&quot; queue → enables 100-client scale&lt;br&gt;2. Langfuse cost-anomaly alerts → prevents runaway-agent margin erosion&lt;br&gt;3. Twenty CRM churn flags → catches churn before cancellation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontSize=12;" vertex="1" parent="1">
