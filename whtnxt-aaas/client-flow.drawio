        <mxCell id="sf1" value="Email · whtnxt.io site&lt;br&gt;Calendly · Google Meet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sf2" value="Inbox · app.whtnxt.io&lt;br&gt;Wizard (Next.js)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="420" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sf3" value="Dashboard · their live site&lt;br&gt;Action Cards · Langfuse trace" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="420" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sf4" value="Email digest · Dashboard&lt;br&gt;Realtime Recent Changes feed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="880" y="420" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sf5" value="Branded PDF report&lt;br&gt;Dashboard · trace link" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1160" y="420" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sf6" value="Monthly emails&lt;br&gt;Dashboard · Stripe billing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1440" y="420" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sf7" value="Dashboard cancel button&lt;br&gt;Final report email" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1720" y="420" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- Load-bearing assets -->
        <mxCell id="client-loadbearing" value="&lt;b&gt;Load-bearing client moments&lt;/b&gt; (these decide retention)&lt;br&gt;1. The 4-step wizard — every minute of friction loses 5% of activations&lt;br&gt;2. The first Action Card queue — if it's not impressive in session 1, they're already evaluating cancellation&lt;br&gt;3. The &quot;Why this?&quot; trace link — makes the agent feel intelligent, not random&lt;br&gt;4. The monthly report — auto-generated, but read by humans · this is the renewal artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="900" height="120" as="geometry" />
        </mxCell>

        <!-- Architectural rule -->
        <mxCell id="rule" value="&lt;b&gt;Architectural rule&lt;/b&gt;&lt;br&gt;&lt;br&gt;Touch points the client experiences as &lt;i&gt;automated&lt;/i&gt; should never feel obviously automated.&lt;br&gt;&lt;br&gt;Touch points they experience as &lt;i&gt;personal&lt;/i&gt; (welcome, day-7 email, monthly note, churn call) must actually be personal.&lt;br&gt;&lt;br&gt;That 5 minutes of human note on the monthly report is what separates this from a SaaS tool." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="510" width="980" height="120" as="geometry" />
        </mxCell>

